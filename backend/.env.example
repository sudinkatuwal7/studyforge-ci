# Export these variables into the backend process before running manage.py.
# Django does not automatically load this file.
POSTGRES_DB=studyforge
POSTGRES_USER=studyforge
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Export for the API publisher; use the same broker as Person 4's worker.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional absolute storage directory, shared with the worker.
# MEDIA_ROOT=C:/path/to/private/studyforge-media

# Gemini chunk embeddings. Export this file into the worker process.
# Do not commit a real key.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16

# OAuth 2.0 Web client ID from Google Cloud Console (Credentials). Google sign-in
# returns 503 while this is empty. The frontend uses the same client ID.
GOOGLE_OAUTH_CLIENT_ID=

# Shared with standalone processing workers for PDF retrieval and result callbacks.
# Generate a long random value and configure the same value for both services.
PROCESSING_SERVICE_TOKEN=
# Processing workers reach a host-run Django server through this host address.
PROCESSING_DJANGO_API_URL=http://host.docker.internal:8000
