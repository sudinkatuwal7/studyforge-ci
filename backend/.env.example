# Export these variables into the backend process before running manage.py.
# Django does not automatically load this file.
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=  # Inject a strong value in production.
# DJANGO_ALLOWED_HOSTS=api.example.test
POSTGRES_DB=studyforge
POSTGRES_USER=studyforge
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# POSTGRES_CONNECT_TIMEOUT=3
# Production database TLS: verify-full with the provider CA file.
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/path/to/postgres-ca.pem

# API publisher; use the same broker as the standalone processing workers.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Production: use rediss:// with authentication and certificate verification.
# Local filesystem storage; the standalone worker fetches private uploads
# through Django's authenticated internal endpoint.
DOCUMENT_STORAGE_BACKEND=filesystem
# Optional absolute backend storage directory.
# MEDIA_ROOT=C:/path/to/private/studyforge-media
# Production S3-compatible private object storage. Keys stay in Document.file.
# DOCUMENT_STORAGE_BACKEND=s3
# DOCUMENT_STORAGE_BUCKET=your-private-bucket
# DOCUMENT_STORAGE_REGION=your-region
# DOCUMENT_STORAGE_ENDPOINT_URL=https://your-storage-endpoint
# DOCUMENT_STORAGE_ACCESS_KEY_ID=  # Omit both key variables for workload identity.
# DOCUMENT_STORAGE_SECRET_ACCESS_KEY=
# DOCUMENT_STORAGE_SESSION_TOKEN=
# DOCUMENT_STORAGE_CA_BUNDLE=/path/to/storage-ca.pem
# DOCUMENT_STORAGE_CONNECT_TIMEOUT=3
# DOCUMENT_STORAGE_READ_TIMEOUT=10
# DOCUMENT_STORAGE_ADDRESSING_STYLE=path  # Typical for custom endpoints; AWS defaults to auto.
# DOCUMENT_STORAGE_ALLOW_HTTP=1  # Isolated local MinIO only.
# STUDYFORGE_REQUIRE_SECURE_CONNECTIONS=1  # Enforce production DB, Redis, storage settings.

# Gemini query embeddings used by knowledge retrieval.
# Do not commit a real key.
GEMINI_API_KEY=
# Pandu voice transcription uses GEMINI_API_KEY above.
GEMINI_VOICE_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# OAuth 2.0 Web client ID from Google Cloud Console (Credentials). Google sign-in
# returns 503 while this is empty. The frontend uses the same client ID.
GOOGLE_OAUTH_CLIENT_ID=

# Shared with standalone processing workers for PDF retrieval and result callbacks.
# Generate a long random value and configure the same value for both services.
PROCESSING_SERVICE_TOKEN=
# Local Compose workers reach a host-run Django server through this address.
PROCESSING_DJANGO_API_URL=http://host.docker.internal:8000

# Text generation: fake (offline default), gemini, or openai.
# Gemini uses GEMINI_API_KEY above; OpenAI uses OPENAI_API_KEY.
NOTES_LLM_BACKEND=gemini
QUIZ_LLM_BACKEND=gemini
RAG_LLM_BACKEND=gemini
NOTES_LLM_MODEL=gemini-flash-latest
QUIZ_LLM_MODEL=gemini-flash-latest
RAG_LLM_MODEL=gemini-flash-latest
