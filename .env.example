# Optional overrides for docker-compose.yml.
# Copy to .env only if you need different local values.
# Do not commit .env. The Compose file already has development defaults.

POSTGRES_DB=studyforge
POSTGRES_USER=studyforge
POSTGRES_PASSWORD=studyforge_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_PORT=6379

# Django and Celery run on your machine, outside Docker, so they use localhost.
# A future containerized Django app would use redis://redis:6379/0 instead.
CELERY_BROKER_URL=redis://localhost:6379/0
